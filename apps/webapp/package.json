{
  "name": "webapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "portless run --name z8 pnpm run dev:direct",
    "dev:direct": "pnpm run i18n:metadata && node --require ./scripts/portless-env.cjs ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:webpack": "pnpm run i18n:metadata && portless run --name z8 node --require ./scripts/portless-env.cjs ./node_modules/next/dist/bin/next dev --webpack",
    "build": "pnpm run i18n:metadata && pnpm run generate-licenses && next build",
    "start": "next start",
    "test": "pnpm run i18n:metadata && vitest run --project unit",
    "public-api:openapi": "vitest run src/lib/public-api/openapi.test.ts --project unit --update",
    "i18n:metadata": "tsx scripts/generate-catalog-metadata.ts",
    "i18n:pull": "tolgee pull && pnpm run i18n:metadata",
    "test:integration": "bash ./scripts/run-approval-workflow-repository-integration.sh",
    "test:approval-workflow-repository:integration": "pnpm run test:integration",
    "test:watch": "pnpm run i18n:metadata && vitest --project unit",
    "test:coverage": "pnpm run i18n:metadata && vitest run --project unit --coverage",
    "auth:generate": "pnpm dlx auth@1.7.22 generate --config ./src/lib/auth.cli.ts --output ./src/db/auth-schema.ts --yes",
    "auth:migrate": "pnpm run auth:generate && pnpm run db:push",
    "typecheck": "next typegen && tsc --project tsconfig.typecheck.json --noEmit --incremental false && tsc --project tsconfig.workflow-contracts.json --noEmit --incremental false && tsc --project tsconfig.smoke.json --noEmit --incremental false",
    "generate-licenses": "node -e \"require('node:fs').mkdirSync('./src/data', { recursive: true })\" && pnpm dlx license-report --only=prod --output=json --config license-report-config.json > ./src/data/licenses.json",
    "db:push": "drizzle-kit push && pnpm run db:install-departure-access",
    "db:install-departure-access": "tsx scripts/install-employee-departure-access.ts",
    "db:seed": "tsx src/db/seed/do-seed.ts",
    "approvals:list": "tsx scripts/approvals.ts list",
    "approvals:delete": "tsx scripts/approvals.ts delete",
    "approvals:pilot-readiness": "tsx scripts/approval-pilot-readiness.ts",
    "time:pilot-readiness": "tsx scripts/time-pilot-readiness.ts",
    "rollout:rollback-readiness": "tsx scripts/rollback-readiness.ts",
    "queue:obliterate": "tsx scripts/obliterate-job-queue.ts",
    "work-records:attach-missing": "tsx --import ./src/worker-preload.mjs scripts/attach-missing-work-records.ts",
    "billing:reconcile-kiosk-seats": "tsx --import ./src/worker-preload.mjs scripts/reconcile-kiosk-seats.ts",
    "personnel-files:minimise-purged-audits": "tsx --import ./src/worker-preload.mjs scripts/minimise-purged-document-audits.ts",
    "employees:backfill-deactivations": "tsx --import ./src/worker-preload.mjs scripts/backfill-former-employees.ts"
  },
