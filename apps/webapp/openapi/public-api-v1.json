								}
							}
						},
						"content": {
							"application/problem+json": {
								"schema": {
									"$ref": "#/components/schemas/Problem"
								}
							}
						}
					},
					"401": {
						"description": "`invalid_key`: the API key is missing, unknown, revoked or expired.",
						"headers": {
