							"default": 50,
							"type": "integer",
							"minimum": 1,
							"maximum": 200
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"required": false,
						"description": "The `nextCursor` of the previous page. Omit it for the first page.",
						"schema": {
							"type": "string",
							"minLength": 1,
							"maxLength": 1024
						}
					},
