								}
							},
							"X-RateLimit-Reset": {
								"description": "When that window resets, as Unix epoch seconds.",
								"schema": {
									"type": "integer"
								}
							}
						},
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"data": {
											"type": "array",
											"items": {
												"type": "object",
												"properties": {
													"id": {
														"type": "string",
														"format": "uuid"
													},
													"firstName": {
														"type": [
															"string",
															"null"
														]
													},
													"lastName": {
														"type": [
															"string",
															"null"
														]
													},
													"workEmail": {
														"type": "string"
													},
													"employeeNumber": {
														"type": [
															"string",
															"null"
														]
													},
													"teamIds": {
														"type": "array",
														"items": {
															"type": "string",
															"format": "uuid"
														},
														"description": "Every team the employee belongs to."
													},
													"managerId": {
														"anyOf": [
															{
																"type": "string",
																"format": "uuid"
															},
															{
																"type": "null"
															}
														],
														"description": "The employee's primary manager, an employee id."
													},
													"status": {
														"type": "string",
														"enum": [
															"active",
															"departed"
														],
														"description": "`departed` once the employee's departure has taken effect."
													},
													"startDate": {
														"anyOf": [
															{
																"type": "string",
																"format": "date",
																"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
																"description": "A local calendar date, YYYY-MM-DD."
															},
															{
																"type": "null"
															}
														]
													},
													"departureDate": {
														"anyOf": [
															{
																"type": "string",
																"format": "date",
																"pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
																"description": "A local calendar date, YYYY-MM-DD."
															},
															{
																"type": "null"
															}
														],
														"description": "The last working day of a scheduled or completed departure."
													}
												},
												"required": [
													"id",
													"firstName",
													"lastName",
													"workEmail",
													"employeeNumber",
													"teamIds",
													"managerId",
													"status",
													"startDate",
													"departureDate"
												],
												"additionalProperties": false,
												"title": "Employee"
											}
										},
