{
	"compilerOptions": {
		"target": "ES2024",
		"lib": ["ES2024", "DOM"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["*.ts", "scripts/*.ts"]
}
