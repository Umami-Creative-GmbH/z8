{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "nextjs"],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"jsx-a11y/anchor-is-valid": "warn",
		"jsx-a11y/interactive-supports-focus": "off",
		"jsx-a11y/prefer-tag-over-role": "off",
		"jsx-a11y/role-has-required-aria-props": "warn",
		"jsx-a11y/click-events-have-key-events": "warn",
		"jsx-a11y/label-has-associated-control": "off",
		"react/no-danger": "warn",
		"react/no-array-index-key": "warn",
		"react/exhaustive-deps": "warn",
		"typescript/no-explicit-any": "off",
		"typescript/no-non-null-assertion": "off",
		"eslint/no-shadow-restricted-names": "warn",
		"eslint/no-unused-vars": ["warn", { "args": "all", "argsIgnorePattern": "^_" }],
		"eslint/no-sequences": "warn",
		"nextjs/no-img-element": "off"
	},
	"ignorePatterns": [
		"**/node_modules/**",
		"**/.next/**",
		"**/.source/**",
		"**/dist/**",
		"**/build/**",
		"**/.turbo/**",
		"**/coverage/**",
		"**/target/**",
		"**/*.min.js",
		"apps/webapp/src/db/auth-schema.ts",
		"apps/webapp/src/data/licenses.json"
	]
}
