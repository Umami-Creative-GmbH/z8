# syntax=docker/dockerfile:1.4
ARG NODE_VERSION=26
ARG PNPM_VERSION=12.21.0
ARG TURBO_VERSION=2.11.7
ARG NEXT_DEPLOYMENT_ID
ARG BUILD_HASH
ARG NEXT_PUBLIC_BUILD_HASH

FROM node:${NODE_VERSION}-alpine AS base

RUN apk add --no-cache \
    ca-certificates \
    curl \
    libc6-compat \
    libstdc++ \
    tini

ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}/bin:${PNPM_HOME}:${PATH}
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    TZ=UTC \
    PGOPTIONS="-c timezone=UTC"

RUN mkdir -p "${PNPM_HOME}" && \
    npm install --global pnpm@${PNPM_VERSION}

WORKDIR /app

FROM base AS turbo-source

ARG TURBO_VERSION
RUN pnpm add -g turbo@${TURBO_VERSION}

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml turbo.json ./
COPY patches ./patches
COPY apps ./apps
COPY packages ./packages

FROM turbo-source AS pruner
RUN turbo prune webapp --docker

FROM base AS deps
COPY --from=pruner /app/out/json/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --store-dir /root/.local/share/pnpm/store --lockfile-only && \
    pnpm install --store-dir /root/.local/share/pnpm/store --frozen-lockfile

FROM base AS workspace
ENV SKIP_ENV_VALIDATION=1
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/webapp/node_modules ./apps/webapp/node_modules
COPY --from=pruner /app/out/full/ ./
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
COPY .oxfmtrc.json ./

FROM workspace AS webapp-builder
ENV CI=true
ARG NEXT_DEPLOYMENT_ID
ARG BUILD_HASH
ARG NEXT_PUBLIC_BUILD_HASH
ENV NEXT_DEPLOYMENT_ID=${NEXT_DEPLOYMENT_ID} \
    BUILD_HASH=${BUILD_HASH} \
    NEXT_PUBLIC_BUILD_HASH=${NEXT_PUBLIC_BUILD_HASH}
RUN pnpm --filter webapp run generate-licenses || echo "{}" > apps/webapp/src/data/licenses.json
RUN pnpm --filter webapp run i18n:metadata
# Server action IDs are salted with NEXT_SERVER_ACTIONS_ENCRYPTION_KEY at build
# time. A stable key keeps IDs stable across deployments so open tabs keep working.
RUN --mount=type=cache,id=next-cache,target=/app/apps/webapp/.next/cache \
    --mount=type=secret,id=next_server_actions_encryption_key,required=false \
    if [ -s /run/secrets/next_server_actions_encryption_key ]; then \
      export NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="$(cat /run/secrets/next_server_actions_encryption_key)"; \
    else \
      echo "WARNING: next_server_actions_encryption_key build secret missing; server action IDs will change on every build" >&2; \
    fi && \
    pnpm --filter webapp exec next build

# Preserve pnpm's relative links and the files used by the logging worker.
RUN --mount=type=bind,source=docker/scripts,target=/tmp/docker-scripts \
    set -o pipefail && \
    node /tmp/docker-scripts/standalone-runtime-files.mjs > /tmp/runtime-files && \
    tar -cf - -T /tmp/runtime-files | tar -xf - -C apps/webapp/.next/standalone && \
    rm /tmp/runtime-files

FROM node:${NODE_VERSION}-alpine AS webapp

RUN apk add --no-cache ca-certificates curl libc6-compat libstdc++ tini
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    TZ=UTC \
    PGOPTIONS="-c timezone=UTC"
WORKDIR /app

ARG NEXT_DEPLOYMENT_ID
ARG BUILD_HASH
ARG NEXT_PUBLIC_BUILD_HASH
ENV NEXT_DEPLOYMENT_ID=${NEXT_DEPLOYMENT_ID} \
    BUILD_HASH=${BUILD_HASH} \
    NEXT_PUBLIC_BUILD_HASH=${NEXT_PUBLIC_BUILD_HASH}

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 app && \
    chown app:nodejs /app

# The tracing root is the monorepo root, so the emitted server stays under apps/webapp.
# public and static assets are intentionally outside Next's traced server output.
COPY --from=webapp-builder --chown=app:nodejs /app/apps/webapp/.next/standalone ./
COPY --from=webapp-builder --chown=app:nodejs /app/apps/webapp/.next/static ./apps/webapp/.next/static
COPY --from=workspace --chown=app:nodejs /app/apps/webapp/public ./apps/webapp/public
COPY docker/scripts/verify-standalone.mjs /tmp/verify-standalone.mjs
# Resolve from the artifact itself; fail if tracing accidentally relies on builder files.
RUN node /tmp/verify-standalone.mjs /app --native && rm /tmp/verify-standalone.mjs

WORKDIR /app/apps/webapp

USER app
EXPOSE 3000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1
